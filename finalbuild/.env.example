DATABASE_URL=postgresql+psycopg://diagnostic:diagnostic@localhost:5432/diagnostic

# Phase 32 local llama.cpp server (no Ollama, no Python llama_cpp binding)
DIAGNOSTIC_LLM_PROVIDER=llama-server
LOCAL_LLM_MODEL_PATH=models/Qwen3-8B-Q4_K_M.gguf
LOCAL_LLM_SERVER_URL=http://127.0.0.1:8000
LOCAL_LLM_SERVER_MODEL=Qwen3-8B-Q4_K_M.gguf
LOCAL_LLM_SERVER_PATH=
LOCAL_LLM_SERVER_HOST=127.0.0.1
LOCAL_LLM_SERVER_PORT=8000
LOCAL_LLM_SERVER_CONTEXT=2048
LOCAL_LLM_SERVER_THREADS=8
LOCAL_LLM_SERVER_STARTUP_TIMEOUT_S=180
LOCAL_LLM_MAX_TOKENS=1200
LOCAL_LLM_TEMPERATURE=0.1
LOCAL_LLM_MAX_CONTEXT_CHARS=50000

# Optional OpenAI-compatible self-hosted provider
# DIAGNOSTIC_LLM_PROVIDER=openai-compatible
# LLM_BASE_URL=http://localhost:8001
# LLM_MODEL=local-model
# LLM_API_KEY=

EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=CONFIGURE_ME

AI_CAR_BACKEND_HOST=127.0.0.1
AI_CAR_BACKEND_PORT=8001
AI_CAR_LIVE_AI_TIMEOUT_S=300
